# Server
PORT=3000
HOST=0.0.0.0

# Public URL seen by browsers (dock, mobile, OAuth redirects). No trailing slash.
# Local npm:     http://localhost:3000
# Local Docker:  http://localhost:4003  (compose maps host 4003 → container 3000)
# Production:    https://cuesports.macleod.systems
PUBLIC_URL=http://localhost:3000

# Database: sqlite (default) or supabase
# CueSport Cloud (npm start / Docker → src/index.js) reads SQLITE_PATH → cuesport.db
DB_DRIVER=sqlite
# Local npm:  ./data/cuesport.db
# Docker:     /app/data/cuesport.db  (set automatically in docker-compose.yml / Dockerfile)
SQLITE_PATH=./data/cuesport.db

# Supabase (optional — for Google OAuth in production)
# Use Project Settings → API Keys: publishable + secret (not legacy anon / service_role JWTs).
# Docs: https://supabase.com/docs/guides/getting-started/api-keys
SUPABASE_URL=
# Publishable key (sb_publishable_…) — browser OAuth + server createClient (required for Google sign-in)
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…) — server-only; never expose via /api/config/public or browser clients
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=

# Supabase Auth redirect URLs must include:
#   {PUBLIC_URL}/auth/callback
#   {PUBLIC_URL}/web/dashboard/
#   {PUBLIC_URL}/dashboard

# Dev / self-host testing: secret login on dashboard (no Google required)
ALLOW_DEV_AUTH=true
# Required when ALLOW_DEV_AUTH=true — set a long random value in production containers
DEV_AUTH_SECRET=change-me-before-deploy
# Required when ALLOW_DEV_AUTH=true — stable email for this instance's account
# Use your real Google address if you may later migrate the same DB to managed cloud
DEV_AUTH_ACCOUNT_EMAIL=you@example.com

# Platform admin (hosted multi-tenant): comma-separated Google account emails.
# Those users see the Dashboard Admin tab and can call /api/admin/* (support trials, revoke keys, etc.).
# PLATFORM_ADMIN_EMAILS=you@example.com,ops@example.com

# Set false in production when using Supabase OAuth only
# ALLOW_DEV_AUTH=false

# -----------------------------------------------------------------------------
# Room cleanup (Model A — rooms are runtime addresses; match history is kept)
# Seats are OBS Dock Keys. Rooms are created on dock connect and pruned after idle.
# match_events are NEVER deleted on room cleanup (room_id set NULL).
# -----------------------------------------------------------------------------
# ROOM_CLEANUP_GRACE_MS=2700000
# ROOM_IDLE_TTL_MS=1209600000
# ROOM_CLEANUP_SWEEPER_MS=600000

# -----------------------------------------------------------------------------
# Subscription tier quotas (OBS Dock Keys / table safety ceiling / mobile+guest)
# Same rules for managed cloud and self-host Docker.
# One OBS Dock Key = one table + one live dock connection (create one key per table).
# maxRooms is a safety ceiling aligned with keys, not a separate user-facing meter.
#
# Default when TIER_DEFAULT is unset:
#   ALLOW_DEV_AUTH=true  → selfhost (same caps as starter)
#   ALLOW_DEV_AUTH=false → starter
#
# Built-in tiers:
#   starter     — 2 dock keys / 2 rooms max / 5 mobile+guest connections per table
#   pro         — 3 dock keys / 3 rooms max / 5 mobile+guest connections per table
#   enterprise  — 10 dock keys / 10 rooms max / 5 mobile+guest connections per table
#   selfhost    — same as starter (2 / 2 / 5)
# -----------------------------------------------------------------------------
# TIER_DEFAULT=selfhost
# Override one field on one tier:
# TIER_STARTER_MAX_API_KEYS=2
# TIER_STARTER_MAX_ROOMS=2
# TIER_STARTER_MAX_CONTROL_CONNECTIONS=5
# TIER_PRO_MAX_API_KEYS=3
# TIER_PRO_MAX_ROOMS=3
# TIER_PRO_MAX_CONTROL_CONNECTIONS=5
# TIER_ENTERPRISE_MAX_API_KEYS=10
# TIER_SELFHOST_MAX_API_KEYS=2
# Or replace the whole catalog (JSON object of tier → caps):
# TIER_LIMITS_JSON={"starter":{"maxApiKeys":2,"maxRooms":2,"maxControlConnectionsPerRoom":5},"pro":{"maxApiKeys":3,"maxRooms":3,"maxControlConnectionsPerRoom":5},"enterprise":{"maxApiKeys":10,"maxRooms":10,"maxControlConnectionsPerRoom":5},"selfhost":{"maxApiKeys":2,"maxRooms":2,"maxControlConnectionsPerRoom":5}}
