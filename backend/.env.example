# Server
PORT=3000
HOST=0.0.0.0

# Public URL seen by browsers (dock, mobile, OAuth redirects). No trailing slash.
# Local npm:     http://localhost:3000
# Local Docker:  http://localhost:4003  (compose maps host 4003 → container 3000)
# Production:    https://cuesport.macleod.systems
PUBLIC_URL=http://localhost:3000

# Database: sqlite (default) or supabase
# CueSport Scoreboard Cloud (npm start / Docker → src/index.js) reads SQLITE_PATH → cuesport.db
DB_DRIVER=sqlite
# Local npm:  ./data/cuesport.db
# Docker:     /app/data/cuesport.db  (set automatically in docker-compose.yml / Dockerfile)
SQLITE_PATH=./data/cuesport.db

# -----------------------------------------------------------------------------
# Google sign-in (via Supabase Auth)
# Google Client ID / Client Secret are configured in the Supabase dashboard
# (Authentication → Providers → Google), not as CueSport env vars.
# CueSport only needs the project URL + API keys below (loaded by Docker via env_file).
# Docs: https://supabase.com/docs/guides/getting-started/api-keys
# -----------------------------------------------------------------------------
SUPABASE_URL=
# Publishable key (sb_publishable_…) — browser OAuth + server createClient (required for Google sign-in)
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…) — server-only; never expose via /api/config/public or browser clients
SUPABASE_SECRET_KEY=
# Optional: JWT Secret for local HS256 verify. Leave empty to use JWKS from SUPABASE_URL.
SUPABASE_JWT_SECRET=
# Google OAuth Web Client ID (from Google Cloud Console / Supabase → Auth → Google).
# Enables the official Sign in with Google button (GIS). Same client ID as the Supabase Google provider.
# Authorized JavaScript origins must include PUBLIC_URL (and http://localhost:3000 for local).
# GOOGLE_OAUTH_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com

# Supabase → Authentication → URL Configuration — add all you use:
#   Site URL = PUBLIC_URL
#   Redirect URLs:
#     {PUBLIC_URL}/dashboard
#     {PUBLIC_URL}/web/dashboard/
#     {PUBLIC_URL}/auth/callback

# Platform admin (hosted multi-tenant): comma-separated Google account emails.
# Those users see the Dashboard Admin tab and can call /api/admin/* (complimentary access, revoke keys, etc.).
# PLATFORM_ADMIN_EMAILS=you@example.com,ops@example.com

# -----------------------------------------------------------------------------
# Dev / self-host testing: secret login on dashboard (no Google required)
# Set ALLOW_DEV_AUTH=false once Google OAuth is configured for production.
# -----------------------------------------------------------------------------
ALLOW_DEV_AUTH=true
# Required when ALLOW_DEV_AUTH=true — set a long random value in production containers
DEV_AUTH_SECRET=change-me-before-deploy
# Required when ALLOW_DEV_AUTH=true — stable email for this instance's account
# Use your real Google address if you may later migrate the same DB to managed cloud
DEV_AUTH_ACCOUNT_EMAIL=you@example.com

# -----------------------------------------------------------------------------
# Stripe billing (managed cloud only — leave empty / commented for self-host)
#
# Dashboard setup (Test mode first):
#   1. Three Products + monthly USD Prices (amounts only in Stripe):
#        Streamer                 → STRIPE_PRICE_STREAMER
#          metadata trial_period_days=14
#        Tournament Organizer     → STRIPE_PRICE_TOURNAMENT_ORGANIZER  (no trial)
#        League Director          → STRIPE_PRICE_LEAGUE_DIRECTOR       (no trial)
#   2. Customer Portal: payment method, cancel at period end, switch among 3 prices
#   3. Enable Stripe Tax (Checkout sends automatic_tax + tax ID collection)
#   4. API secret key + webhook signing secret
# Webhook endpoint: {PUBLIC_URL}/api/stripe/webhook
# Events: checkout.session.completed, customer.subscription.*, invoice.paid, invoice.payment_failed
# Local: stripe listen --forward-to localhost:4003/api/stripe/webhook
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STREAMER=
STRIPE_PRICE_TOURNAMENT_ORGANIZER=
STRIPE_PRICE_LEAGUE_DIRECTOR=
BILLING_CONTACT_URL=mailto:you@example.com

# Legal / support (Terms + Privacy templates at /terms and /privacy — counsel review required)
# SUPPORT_ISSUES_URL=https://github.com/iainsmacleod/CueSport-Scoreboard/issues
LEGAL_CONTACT_EMAIL=you@example.com
LEGAL_ENTITY_NAME=MacLeod Systems Consulting, LLC
LEGAL_GOVERNING_LAW=Province of Ontario, Canada

# -----------------------------------------------------------------------------
# Room cleanup (Model A — rooms are runtime addresses; match history is kept)
# Seats are OBS Dock Keys. Rooms are created on dock connect and pruned after idle.
# match_events are NEVER deleted on room cleanup (room_id set NULL).
# -----------------------------------------------------------------------------
# ROOM_CLEANUP_GRACE_MS=2700000
# ROOM_IDLE_TTL_MS=1209600000
# ROOM_CLEANUP_SWEEPER_MS=600000

# -----------------------------------------------------------------------------
# Subscription tier quotas (OBS Dock Keys / table safety ceiling / mobile+guest)
# Same rules for managed cloud and self-host Docker.
# One OBS Dock Key = one table + one live dock connection (create one key per table).
# maxRooms is a safety ceiling aligned with keys, not a separate user-facing meter.
#
# Default when TIER_DEFAULT is unset:
#   ALLOW_DEV_AUTH=true  → selfhost (same caps as streamer)
#   ALLOW_DEV_AUTH=false → streamer
#
# Managed: new Google accounts start subscription_status=inactive until Stripe Checkout.
# Existing active rows are grandfathered. Self-host accounts stay active.
#
# Built-in products (Stripe Product name → internal id):
#   Streamer               → streamer               — 2 seats / 2 rooms / 5 mobile+guest per table (Checkout)
#   Tournament Organizer   → tournament_organizer   — 5 seats / 5 rooms / 5 mobile+guest per table (Checkout)
#   League Director        → league_director        — 10 seats / 10 rooms / 5 mobile+guest per table (Checkout)
#   Network Organization   → network_organization   — 25 / 25 / 10 (contact only — no Checkout)
#   Self-host              → selfhost               — 2 / 2 / 5 (not sold; ALLOW_DEV_AUTH default)
# -----------------------------------------------------------------------------
# TIER_DEFAULT=selfhost
# Override one field on one tier (Compose defaults match these if unset):
# TIER_STREAMER_MAX_API_KEYS=2
# TIER_STREAMER_MAX_ROOMS=2
# TIER_STREAMER_MAX_CONTROL_CONNECTIONS=5
# TIER_TOURNAMENT_ORGANIZER_MAX_API_KEYS=5
# TIER_TOURNAMENT_ORGANIZER_MAX_ROOMS=5
# TIER_TOURNAMENT_ORGANIZER_MAX_CONTROL_CONNECTIONS=5
# TIER_LEAGUE_DIRECTOR_MAX_API_KEYS=10
# TIER_LEAGUE_DIRECTOR_MAX_ROOMS=10
# TIER_LEAGUE_DIRECTOR_MAX_CONTROL_CONNECTIONS=5
# TIER_NETWORK_ORGANIZATION_MAX_API_KEYS=25
# TIER_NETWORK_ORGANIZATION_MAX_ROOMS=25
# TIER_NETWORK_ORGANIZATION_MAX_CONTROL_CONNECTIONS=10
# TIER_SELFHOST_MAX_API_KEYS=2
# TIER_SELFHOST_MAX_ROOMS=2
# TIER_SELFHOST_MAX_CONTROL_CONNECTIONS=5
# Or replace the whole catalog (JSON object of tier → caps):
# TIER_LIMITS_JSON={"streamer":{"maxApiKeys":2,"maxRooms":2,"maxControlConnectionsPerRoom":5},"tournament_organizer":{"maxApiKeys":5,"maxRooms":5,"maxControlConnectionsPerRoom":5},"league_director":{"maxApiKeys":10,"maxRooms":10,"maxControlConnectionsPerRoom":5},"selfhost":{"maxApiKeys":2,"maxRooms":2,"maxControlConnectionsPerRoom":5}}
