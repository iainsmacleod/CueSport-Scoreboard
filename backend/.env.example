# Server
PORT=3000
HOST=0.0.0.0

# Public URL seen by browsers (dock, mobile, OAuth redirects). No trailing slash.
# Local npm:     http://localhost:3000
# Local Docker:  http://localhost:4003  (compose maps host 4003 → container 3000)
# Production:    https://cuesports.macleod.systems
PUBLIC_URL=http://localhost:3000

# Database: sqlite (default) or supabase
# CueSport Cloud (npm start / Docker → src/index.js) reads SQLITE_PATH → cuesport.db
DB_DRIVER=sqlite
# Local npm:  ./data/cuesport.db
# Docker:     /app/data/cuesport.db  (set automatically in docker-compose.yml / Dockerfile)
SQLITE_PATH=./data/cuesport.db
# Legacy stream server only (node server.js → db.js); different schema — do not reuse cuesport.db
# DB_PATH=./data/streams.db

# Supabase (optional — for Google OAuth in production)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=

# Supabase Auth redirect URLs must include:
#   {PUBLIC_URL}/auth/callback
#   {PUBLIC_URL}/web/dashboard/
#   {PUBLIC_URL}/dashboard

# Dev / self-host testing: secret login on dashboard (no Google required)
ALLOW_DEV_AUTH=true
# Required when ALLOW_DEV_AUTH=true — set a long random value in production containers
DEV_AUTH_SECRET=change-me-before-deploy
# Single account email for this self-host instance (optional)
# DEV_AUTH_ACCOUNT_EMAIL=dev@local

# Set false in production when using Supabase OAuth only
# ALLOW_DEV_AUTH=false

# -----------------------------------------------------------------------------
# Subscription tier quotas (OBS Dock Keys / tables / mobile+guest control connections)
# Same rules for managed cloud and self-host Docker. All three caps are configurable.
#
# Default when TIER_DEFAULT is unset:
#   ALLOW_DEV_AUTH=true  → selfhost (same caps as starter)
#   ALLOW_DEV_AUTH=false → starter
#
# Built-in tiers:
#   starter     — 1 OBS Dock Key  / 2 tables  / 5 mobile+guest connections per table
#   pro         — 3 OBS Dock Keys / 2 tables  / 5 mobile+guest connections per table
#   enterprise  — 10 OBS Dock Keys / 2 tables / 5 mobile+guest connections per table
#   selfhost    — same as starter (1 / 2 / 5)
# -----------------------------------------------------------------------------
# TIER_DEFAULT=selfhost
# Override one field on one tier:
# TIER_STARTER_MAX_API_KEYS=1
# TIER_STARTER_MAX_ROOMS=2
# TIER_STARTER_MAX_CONTROL_CONNECTIONS=5
# TIER_PRO_MAX_API_KEYS=3
# TIER_PRO_MAX_ROOMS=2
# TIER_PRO_MAX_CONTROL_CONNECTIONS=5
# TIER_ENTERPRISE_MAX_API_KEYS=10
# TIER_SELFHOST_MAX_API_KEYS=1
# Or replace the whole catalog (JSON object of tier → caps):
# TIER_LIMITS_JSON={"starter":{"maxApiKeys":1,"maxRooms":2,"maxControlConnectionsPerRoom":5},"pro":{"maxApiKeys":3,"maxRooms":2,"maxControlConnectionsPerRoom":5},"enterprise":{"maxApiKeys":10,"maxRooms":2,"maxControlConnectionsPerRoom":5},"selfhost":{"maxApiKeys":1,"maxRooms":2,"maxControlConnectionsPerRoom":5}}
